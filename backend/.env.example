# ============================================================
# AI-генератор квизов — настройки
# Скопируйте файл в .env (рядом с этим файлом или в корне проекта)
# и заполните значения.
# ============================================================

# --- LLM (любой OpenAI-совместимый API: DeepSeek, Qwen, GLM, MiMo...) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-ВАШ_КЛЮЧ
LLM_MODEL=deepseek-chat
# Можно указать те же или более дешёвые модели:
LLM_MODEL_CRITIC=deepseek-chat
LLM_MODEL_CHEAP=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Бюджеты генерации ---
GENERATION_BATCH_SIZE=5
GENERATION_MAX_QUESTIONS=20
# Потолок времени job-а; фактический таймаут = max(это значение, 120 + 90*вопросов)
JOB_TIMEOUT_SECONDS=1800
REPAIR_MAX_ITERATIONS=2

# --- Пороги дедупликации (сходство по 1/2/3-граммам) ---
DEDUP_JACCARD_THRESHOLD=0.55
DEDUP_REVIEW_THRESHOLD=0.30

# --- Источник знаний ---
NMAPS_INDEX_URL=https://yandex.ru/support/nmaps/ru/llms.txt

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
# Локально по умолчанию: backend/data/quiz.db ; в Docker: /data/quiz.db
# DATABASE_PATH=/data/quiz.db
# FRONTEND_DIR=/app/frontend
